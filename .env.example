# Environment variables for SpendWise. Never commit real values.
#   - Local development: copy to backend/.env (read by the backend).
#   - Docker Compose: copy to .env at the repo root (read by compose.yaml); see the last section.

ENVIRONMENT=local

# Database. SQLite needs no setup and is the default for local development.
DATABASE_URL=sqlite:///./spendwise.db
# PostgreSQL (production, Docker; optional locally, see README "PostgreSQL"). Replace the
# placeholders; URL-encode special characters in the password (@ -> %40, / -> %2F, % -> %25).
# postgres:// and postgresql:// URLs also work and use the same driver (psycopg 3).
# ENVIRONMENT=production refuses to start unless DATABASE_URL is PostgreSQL.
# DATABASE_URL=postgresql+psycopg://spendwise:CHANGE_ME@localhost:5432/spendwise

# AI provider: "fake" (default) is deterministic, works offline and needs no key.
# "anthropic" requires ANTHROPIC_API_KEY (provider arrives in Issue #2; until then AI features
# report "not available yet" while the rest of the app keeps working).
# Any other value stops the app at startup with an error listing the allowed values.
AI_PROVIDER=fake
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Sign-in sessions. The session cookie is HttpOnly and SameSite=Lax, and always Secure (HTTPS
# only) for requests that arrived over HTTPS. For plain-HTTP requests SESSION_COOKIE_SECURE
# decides: unset means Secure when ENVIRONMENT=production; false allows a production build on
# http://localhost (never set it on a public deployment). SESSION_TTL_DAYS: 1 to 90.
# SESSION_COOKIE_SECURE=
# SESSION_TTL_DAYS=14

# Container startup (Docker image only; see README, "Docker image without Compose").
# PORT: port Uvicorn listens on (default 8000; hosts such as Railway set it).
# DB_WAIT_TIMEOUT: seconds to wait for the database before giving up (default 60).
# FORWARDED_ALLOW_IPS: proxies whose X-Forwarded-Proto/-For are trusted (default *, any).
# PORT=8000
# DB_WAIT_TIMEOUT=60
# FORWARDED_ALLOW_IPS=*

# Built frontend to serve from the backend. The Docker image sets this; leave it unset for local
# development, where `npm run dev` serves the frontend and proxies /api.
# FRONTEND_DIST=../frontend/dist

# Docker Compose (compose.yaml + compose.override.yaml, merged automatically). Compose reads these
# from .env at the REPO ROOT, not backend/.env. All are optional locally: unset, the stack uses the
# development defaults from compose.override.yaml shown here. On Railway, set variables in the
# Railway dashboard instead (README, "Deploy to Railway"); never reuse these defaults there. Compose
# builds DATABASE_URL from them and sets ENVIRONMENT=production itself, so the DATABASE_URL and
# ENVIRONMENT lines above do not affect the stack; AI_PROVIDER, AI_MODEL and ANTHROPIC_API_KEY do.
# Use a URL-safe password (letters, digits, - _ .), e.g. from `openssl rand -hex 24`. The database
# keeps the credentials it was created with; after changing them run `docker compose down -v`
# (this deletes the local database).
# POSTGRES_DB=spendwise
# POSTGRES_USER=spendwise
# POSTGRES_PASSWORD=spendwise-local-only
# APP_PORT=8000
# SESSION_COOKIE_SECURE=false   (local default: the stack is plain HTTP on localhost)
