# Copy to backend/.env for local development. Never commit real values.

ENVIRONMENT=local
DATABASE_URL=sqlite:///./spendwise.db
# DATABASE_URL=postgresql+psycopg://spendwise:spendwise@localhost:5432/spendwise

# AI provider: "fake" works offline with no key; "anthropic" requires ANTHROPIC_API_KEY.
AI_PROVIDER=fake
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
