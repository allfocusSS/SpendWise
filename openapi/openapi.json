  "components": {
    "schemas": {
      "CategoryBreakdown": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date To"
          },
          "total_cents": {
            "type": "integer",
            "title": "Total Cents",
            "description": "Amount in tiyn (1 KZT = 100 tiyn)."
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CategoryBreakdownItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "type",
          "date_from",
          "date_to",
          "total_cents",
          "items"
        ],
        "title": "CategoryBreakdown"
      },
      "CategoryBreakdownItem": {
        "properties": {
          "category_id": {
            "type": "integer",
            "title": "Category Id"
          },
          "category_name": {
            "type": "string",
            "title": "Category Name"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "total_cents": {
            "type": "integer",
            "title": "Total Cents",
            "description": "Amount in tiyn (1 KZT = 100 tiyn)."
          },
          "transaction_count": {
            "type": "integer",
            "title": "Transaction Count"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage"
          }
        },
        "type": "object",
        "required": [
          "category_id",
          "category_name",
          "color",
          "total_cents",
          "transaction_count",
          "percentage"
        ],
        "title": "CategoryBreakdownItem"
      },
      "CategoryCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Name"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "title": "Color",
            "default": "#64748b"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "CategoryCreate"
      },
      "CategoryRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "color",
          "is_default"
        ],
        "title": "CategoryRead"
      },
      "CategoryUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TransactionType"
              },
              {
                "type": "null"
              }
            ]
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CategoryUpdate",
        "description": "All fields optional: only the fields sent are changed."
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "MonthlyTrend": {
        "properties": {
          "months": {
            "items": {
              "$ref": "#/components/schemas/MonthlyTrendItem"
            },
            "type": "array",
            "title": "Months"
          }
        },
        "type": "object",
        "required": [
          "months"
        ],
        "title": "MonthlyTrend"
      },
      "MonthlyTrendItem": {
        "properties": {
          "month": {
            "type": "string",
            "title": "Month"
          },
          "income_cents": {
            "type": "integer",
            "title": "Income Cents",
            "description": "Amount in tiyn (1 KZT = 100 tiyn)."
          },
          "expense_cents": {
            "type": "integer",
            "title": "Expense Cents",
            "description": "Amount in tiyn (1 KZT = 100 tiyn)."
