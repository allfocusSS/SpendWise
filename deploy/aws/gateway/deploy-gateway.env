# Installed as /etc/spendwise/deploy-gateway.env (root:root, 0644) by install-gateway.sh, which
# appends DEPLOY_GATEWAY_HEALTH_URL from /etc/spendwise/deploy.env. Nothing here is secret.
#
# The GitHub Actions runs the gateway accepts: confirmed with
#   gh api repos/allfocusSS/SpendWise --jq '.id, .owner.id'
#   gh api repos/allfocusSS/SpendWise/actions/oidc/customization/sub
# (use_immutable_subject: true, so the subject carries both IDs). The issuer and the event
# (workflow_dispatch) are fixed in the program: https://token.actions.githubusercontent.com.
#
# Only the manual promotion workflow deploys production (docs/environments.md). A push to main
# runs CI (ci.yml) and deploys development (Render) only; ci.yml's tokens are refused here.
DEPLOY_GATEWAY_AUDIENCE=spendwise-deploy
DEPLOY_GATEWAY_REPOSITORY=allfocusSS/SpendWise
DEPLOY_GATEWAY_REPOSITORY_ID=1441102769
DEPLOY_GATEWAY_OWNER_ID=189591398
DEPLOY_GATEWAY_REF=refs/heads/main
DEPLOY_GATEWAY_WORKFLOW=.github/workflows/promote-production.yml
DEPLOY_GATEWAY_SOCKET=/run/spendwise-deploy-gateway/gateway.sock
