# Installed as /etc/systemd/system/spendwise-runner-no-imds.service by install-runner.sh. The
# deploy runner's user never needs the instance metadata service, so it cannot reach it, and with
# it the instance role's credentials. Root, Docker and the SSM agent are not affected.
[Unit]
Description=Block instance metadata (IMDS) for the SpendWise deploy runner's user
After=network-pre.target
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/iptables -w -I OUTPUT -d 169.254.169.254/32 -m owner --uid-owner spendwise-runner -j REJECT
ExecStop=/usr/sbin/iptables -w -D OUTPUT -d 169.254.169.254/32 -m owner --uid-owner spendwise-runner -j REJECT

[Install]
WantedBy=multi-user.target
