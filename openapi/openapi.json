    "/api/analytics/by-category": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Get Category Breakdown",
        "operationId": "get_category_breakdown",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransactionType",
              "default": "expense"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date From"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
